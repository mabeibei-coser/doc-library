# ════════════════════════════════════════════════════════════
# 安防文档库 A800 —— 生产 env 模板
# 部署网址：https://h100.jsai100.com/a800/   端口：4003
# ════════════════════════════════════════════════════════════

NODE_ENV=production
DOC_API_PORT=4003
VITE_BASE_PATH=/a800/

# ── 共享会员 cookie（A800 一库管两域，两套密钥都要填，否则对应域用户拿不到 phone）──
# 与 asg100 / ata100 各自的 *_MEMBER_SESSION_PASSWORD 逐字节一致
ASG_MEMBER_SESSION_PASSWORD=<与 asg100 同一个值>
ATA_MEMBER_SESSION_PASSWORD=<与 ata100 同一个值>
ASG_COOKIE_PATH=/
ATA_COOKIE_PATH=/
ASG_COOKIE_SECURE=true

# ── 会员中心地址（后端按文档 category 选哪个 center 刷 VIP）──
ASG_CENTER_BASE_URL=http://127.0.0.1:4002
ATA_CENTER_BASE_URL=http://127.0.0.1:4004
# 前端"回中心"按钮地址：进 A800 时 URL 上的 ?category= 决定走哪个；裸 URL 时 ASG 兜底。
VITE_CENTER_URL=https://h100.jsai100.com/asg100/
VITE_ATA_CENTER_URL=https://h100.jsai100.com/ata100/

# ── 后台写文档的内部接口密钥（admin-hub 调用时带）──
# 生成一个强随机值：node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
DOC_ADMIN_SECRET=<生成强随机值，admin-hub 那边也要填同一个>
