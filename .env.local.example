# 安防文档库 doc-library —— env 模板。复制成 .env.local 填真值（.env.local 不进 git）。

# ── 共享会员 cookie 密钥（必须与会员中心 asg100/ata100 的 *_MEMBER_SESSION_PASSWORD 完全一致）──
# A800 一库管两域，需要同时配 ASG 和 ATA 两套 cookie 密钥；任一缺失则该域用户拿不到 phone。
ASG_MEMBER_SESSION_PASSWORD=<must-match-asg100-center>
ATA_MEMBER_SESSION_PASSWORD=<must-match-ata100-center>
ASG_COOKIE_SECURE=false

# 会员中心地址（后端按文档 category 选择问哪个 center 刷 VIP）
ASG_CENTER_BASE_URL=http://localhost:4002
ATA_CENTER_BASE_URL=http://localhost:4004
VITE_CENTER_URL=http://localhost:4002/

# 后台写文档的内部接口共享密钥（admin-hub 调用时带，生产换强随机值）
DOC_ADMIN_SECRET=<generate-a-random-secret>

DOC_API_PORT=4003
